{
  "name": "lyric-sync",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "drizzle-orm": "0.45.4",
    "lucide-react": "latest",
    "next": "16.4.3",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "latest",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "0.31.11",
    "drizzle-zod": "0.8.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "pino-pretty": "latest",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
